#!/usr/bin/env bash
# Require every commit to record why it was made.
#
# The ledger in docs/LEDGER.md is only as good as the commit messages behind
# it, and "why" is the one thing that cannot be recovered from the diff later.
#
# Install with: bash scripts/install_hooks.sh
set -eu

message_file="$1"
# Strip comment lines so the template itself never satisfies the check.
body="$(grep -v '^#' "$message_file" || true)"

# Merges, reverts and fixups are generated by Git and are exempt.
subject="$(printf '%s\n' "$body" | sed '/^[[:space:]]*$/d' | head -1)"
case "$subject" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if [ -z "$subject" ]; then
    echo "commit-msg: the commit message is empty." >&2
    exit 1
fi

if ! printf '%s\n' "$body" | grep -qiE '^[[:space:]]*Why:[[:space:]]*[^[:space:]]'; then
    cat >&2 <<'MSG'
commit-msg: this commit has no "Why:" line.

Add one line to the commit message explaining the reason for the change:

    Why: users without a GPU could not use the assistant at all.

It becomes the "Why" column in docs/LEDGER.md. To use the provided template:

    git config commit.template .gitmessage

To bypass this check for a genuine exception, commit with --no-verify.
MSG
    exit 1
fi
exit 0
